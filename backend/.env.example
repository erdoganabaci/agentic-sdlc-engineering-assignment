# Local SQLite database (relative to backend/). Postgres example: postgresql://pricing:pricing@localhost:5433/pricing
DATABASE_URL="file:./dev.db"
# Optional: session-capable URL for Postgres migrations (Supabase direct/session pooler). Falls back to DATABASE_URL.
# DIRECT_URL=""
# Local demo identity via X-User-Id. Never enable in production; startup refuses NODE_ENV=production with this on.
DEMO_AUTH="true"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
