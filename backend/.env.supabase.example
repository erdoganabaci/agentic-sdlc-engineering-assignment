# Optional Supabase development database. SQLite remains the default in .env.
# Copy to .env.supabase and replace PROJECT_REF and YOUR-PASSWORD.
# Percent-encode special characters in the password. Keep TLS verification enabled.
# Download supabase-ca.crt using the README instructions before connecting.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=./supabase-ca.crt"
# Optional migration connection; otherwise migrations use DATABASE_URL.
# Use a direct or session-pooler URL, never a transaction-pooler URL.
# DIRECT_URL=""
DEMO_AUTH="true"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
